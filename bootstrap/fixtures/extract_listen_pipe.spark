# Extract dry person stub + listen/speak/pipeline subset
model fast

extract Person {
  name: string
  age: int
} from "Ada Lovelace was born in 1815" -> person

print person

listen "x.wav" -> t
print t

speak "Hello" -> "out/bootstrap_speak.wav"

pipeline {
  ask "Summarize: Inventory" -> summary
  | ask "Translate to Spanish: gravity" -> es
}
print es

# Typed extract + listen/speak/pipeline subset.
# Dry-run reads the fixture from disk; there is no built-in person.
model fast

extract Person {
  name: string
  age: int
} from "Ada Lovelace was born in 1815"
  fixture "examples/fixtures/extract/person.json" -> person

print person

listen "x.wav" -> t
print t

speak "Hello" -> "out/bootstrap_speak.wav"

pipeline {
  ask "Summarize: Inventory" -> summary
  | ask "Translate to Spanish: gravity" -> es
}
print es

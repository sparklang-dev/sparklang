#!/usr/bin/env bash
# One-shot Spark project loop: compile → dump → local analysis folder.
# Optional: --serve (tiny CPU) · --ask (owned spark-coder or honesty note).
# No cloud upload. Never 6000. Does not claim beat Claude.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
export PYTHONPATH="${ROOT}/python:${ROOT}/tools:${PYTHONPATH:-}"
exec python3 "${ROOT}/tools/spark_analyze/analyze.py" "$@"

#!/usr/bin/env bash
# Train/step proof shortcut — wraps make spark-sgd-proof (tiny fixture).
# Pass SCALE=1 to run spark-sgd-proof-scale instead.
# Coder: SCALE=coder-large → make spark-coder-train-large.
# Prefer 5090 for coder GPU; never 6000. Does not claim beat Claude.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

case "${SCALE:-0}" in
  1|scale|sgd-scale)
    echo "==> make spark-sgd-proof-scale (CPU; not beat Claude)"
    exec make spark-sgd-proof-scale
    ;;
  coder-large|large-coder)
    echo "==> make spark-coder-train-large (5090 OK; never 6000)"
    exec make spark-coder-train-large
    ;;
  *)
    echo "==> make spark-sgd-proof (CPU tiny; not beat Claude)"
    exec make spark-sgd-proof
    ;;
esac

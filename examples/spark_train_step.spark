# TRAIN → STEP → TRAIN_STATUS in one SPARK_BC stream.
# STEP 0x28 is a dry loop tick: ARTIFACT + Spark-created weights.
# Honest: dry ≠ trained. Tiny bytecode-hash delta only — not SGD.
# No GPU. No 6000. No god copy. No Loom. No imported frontier models.
#
# Compile:
# ./spark-bootstrap --compile examples/spark_train_step.spark \
# -o docs/examples/spark-train-step.sparkbc
# Execute:
# ./spark-bootstrap --run-bc docs/examples/spark-train-step.sparkbc
# Weights: out/train/job-dry-001/weights.safetensors (step_n>=1)

model code

model train dataset "examples/fixtures/train/dataset.jsonl" base "fixture-base" out "out/train/job-dry-001" backend "http" method "spark_distill_cpu" -> job

model step "job-dry-001" -> step

model status "job-dry-001" -> status

print job

# Grounded ask — anti-guess (dry playbook)
#
# Prefer SoT / expect before free generate. Companion CLI forces
# verify-before-speak (wrong expect → abstain exit 2):
#
#   ./spark-ground ask --prompt "…" --sot-ok \
#     --expect "2.50" --candidate "2.50"
#   ./spark-ground ask … --candidate "9.99"   # exits 2
#   make test-ground
#
# Honesty: alignment does not erase all lies
# (arxiv.org/abs/2407.16216). Spark makes guessing fail CI via
# forced grounding — not "impossible to lie."
# Recompile ≠ semantics. Never 6000. Does not beat Claude.

# 1) Source of truth (dry fixture — no network invent)
http get "https://example.invalid/sot/dryer-start" fixture "examples/fixtures/abstain/sot_dryer_price.json" timeout 5 -> sot

# 2) Verify SoT before any free generate
expect contains sot "price_usd"
expect contains sot "2.50"
expect contains sot fixture "examples/fixtures/ground/want_price.txt"

# 3) Inventable ask without SoT text → dry abstain (head gate)
head ask "What is the dryer start price at that store right now?" -> answer
expect contains answer fixture "examples/fixtures/abstain/want_abstain_true.txt"
expect contains answer fixture "examples/fixtures/abstain/want_halted_true.txt"

# Live typed extract — schema validate + retry on miss.
# Dry-run still uses fixture (no model). Under --live, spark-extract
# calls spark-ask-http, validates JSON, retries on schema miss.
#
# ./spark --dry-run examples/extract_live.spark
# ./spark --live examples/extract_live.spark # needs gateway + key

model fast

extract Person {
 name: string
 age: int
 email?: string
} from "Ada Lovelace was born in 1815"
 fixture "examples/fixtures/extract/person.json"
 retries 2 -> person

print person

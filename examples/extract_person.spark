# Typed extract — the schema block declares required fields and their
# types; dry-run validates a real fixture against it (no model call).
# ./spark --dry-run examples/extract_person.spark
#
# A trailing "?" marks a field optional: absent is fine, but a wrong type
# is still an error. Mismatches exit non-zero; see examples/extract_bad.spark.

model fast

extract Person {
 name: string
 age: int
 email?: string
} from "Ada Lovelace was born in 1815"
 fixture "examples/fixtures/extract/person.json" -> person

print person

# Streaming ask — live companion SSE path.
# Dry-run never dials; under --live, `ask stream` passes --stream
# to ./spark-ask-http (token deltas, accumulate for -> bind).
#
#   ./spark --dry-run examples/ask_stream.spark
#   ./spark --live examples/ask_stream.spark   # needs AI_GATEWAY_URL

model fast

ask stream "Reply with exactly one word: pong" -> reply

print reply

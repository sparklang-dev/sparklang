# Spark stdlib — data / let / print patterns (bootstrap: include "lib/data.spark")
# Core bindings work in GAS and bootstrap. mode: dry-run | live

model fast

# @helper let_print_hello: Minimal binding and print
# let msg "Hello, Spark"
# print msg

# @helper let_doc_binding: Document text for pipelines
# let doc "Office printers need regular cleaning."

# @helper let_topic_binding: Topic for ask interpolation
# let topic "gravity"

# @helper let_message_binding: User message for classify
# let message "My payment won't go through online"

# @helper let_multi_bindings: Several bindings before pipeline
# let doc "Quarterly report."
# let lang "en"
# let store "Example Store"

# @helper print_classify_result: Print classification JSON
# classify Intent { support, sales } from "help" -> intent
# print intent

# @helper print_extract_result: Print extracted struct
# extract Person { name: string } from "Ada Lovelace" -> person
# print person

# @helper print_pipeline_final: Print last pipeline bind
# pipeline {
#   ask "Summarize: {doc}" -> summary
#   | ask "Title for: {summary}" -> title
# }
# print title

# @helper let_csv_row: Comma-separated row as single string
# let row "name,age,city\nAda,36,London"

# @helper let_csv_header: Header line for csv-ish parsing via ask
# let header "sku,qty,price"

# @helper data_ask_parse_csv: Use ask to parse csv-ish row (honest heuristic)
# let row "WASH-1,3,19.99"
# ask "Parse CSV row into JSON: {row}" -> parsed

# @helper data_table_print: Print tabular ask result
# ask "Format as table: sku=W1 qty=2" -> table
# print table

# @helper let_set_model_output: Capture model op output
# model analyze "fast" -> report
# print report

# @helper let_voice_transcript: Bind listen output
# listen "input.wav" -> transcript
# print transcript

# @helper let_chain_bindings: Second binding from first
# let first "step one"
# let second "follow-up: {first}"

# @helper data_json_print: Print JSON-looking ask output
# ask "JSON object with ok:true" -> json
# print json

# @helper data_debug_bind: Debug print any binding name
# let debug_val "inspect me"
# print debug_val

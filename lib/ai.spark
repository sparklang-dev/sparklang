# Spark stdlib — AI defaults (bootstrap: include "lib/ai.spark")
# Set an explicit model id (HF id / path / configured name).
# `use auto` keeps the prior spark.toml / model line — it does NOT
# pick Bifrost-style aliases from task text.

# Example — uncomment and set your model:
# model "fixtures/tiny-lm"
# model "org/local-lm"

# @helper ai_classify_then_ask: Classify message then generate reply
# let message "Need refund for broken item"
# classify Intent { support, sales } from message -> intent
# ask "Reply as {intent}: {message}" -> reply

# @helper ai_extract_then_ask: Extract fields then summarize
# extract Person { name: string } from "Jane called"
#   fixture "examples/fixtures/extract/lib/person.json" -> person
# ask "Draft greeting for {person}" -> greeting

# @helper ai_question_sugar: Shorthand ? for ask
# let topic "Spark language"
# ? "What is {topic}?" -> answer

# @helper ai_say_sugar: Shorthand say for speak
# say "Welcome to our store"

# @helper ai_include_pipeline: Compose with pipeline stdlib
# include "lib/pipeline.spark"
# let doc "Notes here."

# Spark stdlib — model analyze/compare/improve/train helpers
# bootstrap: include "lib/model.spark"
# mode: dry-run (fixtures only) | live (train via spark-train-http)

model code

# @helper model_analyze_alias: Analyze one gateway alias
# model analyze "fast" -> report

# @helper model_analyze_all: Catalog all reachable aliases
# model analyze all -> catalog_report

# @helper model_compare_suite: Compare models on eval suite
# model compare ["fast", "code", "best"]
#   on suite "examples/eval_suite.json" -> comparison

# @helper model_improve_quality: Heuristic prefer quality
# model improve from report prefer quality -> blueprint

# @helper model_plan_markdown: Optional markdown plan (not weights)
# model plan blueprint into "out/better-model.md"

# @helper model_train_job: Submit training job (dry fixtures or live)
# model train dataset "examples/fixtures/train/dataset.jsonl" \
#   base "fixture-base" out "out/train/job-dry-001" backend "http" -> job

# @helper model_build_alias: model build is an alias for model train
# model build -> job

# @helper model_reverse_local: Inspect published config/index (no tensors)
# model reverse "fixtures/tiny-lm" -> inspect
# model inspect "fixtures/tiny-lm" -> inspect

# @helper model_compile_bc: Compile this program to SPARK_BC
# model compile "examples/model_lab.spark" into "out/lab/model_lab.sparkbc" -> bc

# @helper model_modify_keep: Attach adapters/heads; keep special training
# model modify keep_existing "out/train/existing-lora" \
#   add "out/train/job-dry-001/adapter.bin" \
#   head "out/heads/abstain.pt" -> modified

# @helper model_status_job: Poll job + artifact paths
# model status "job-dry-001" -> status

# @helper model_workflow_train: Train then status
# model train -> job
# model status "job-dry-001" -> status

# @helper model_set_alias: Set default model for following ops
# use best

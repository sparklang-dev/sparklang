  "Spark playbook: classify_and_reply": {
    "prefix": "spark-playbook-classify_and_reply",
    "description": "AI coding playbook from lib/playbooks.spark (classify_and_reply)",
    "body": [
      "include \"lib/ai.spark\"",
      "classify Intent { support, sales } from \"My account is locked and I need help\" -> intent",
      "ask \"Reply helpfully to: My account is locked and I need help\" -> reply",
      "print reply"
    ]
  },
  "Spark playbook: review_and_suggest": {
    "prefix": "spark-playbook-review_and_suggest",
    "description": "AI coding playbook from lib/playbooks.spark (review_and_suggest)",
    "body": [
      "use auto",
      "let report \"{\\\"issues\\\":[\\\"possible eval\\\",\\\"ai-authored patterns\\\"],\\\"complexity\\\":\\\"mid\\\"}\"",
      "ask \"Fix this test failure shown in the review report: {report}\" -> suggestion",
      "print suggestion"
    ]
  },
  "Spark playbook: pipeline_summarize_explain": {
    "prefix": "spark-playbook-pipeline_summarize_explain",
    "description": "AI coding playbook from lib/playbooks.spark (pipeline_summarize_explain)",
    "body": [
      "include \"lib/ai.spark\"",
      "let doc \"Spark is a small language where AI is a first-class primitive.\"",
      "pipeline {",
      "  ask \"Summarize: {doc}\" -> summary",
      "  | ask \"Explain in one sentence: {summary}\" -> plain",
      "}",
      "print plain"
    ]
  }
}

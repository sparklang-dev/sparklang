{
  "Spark playbook: explain_code": {
    "prefix": "spark-playbook-explain_code",
    "description": "AI coding playbook from lib/playbooks.spark (explain_code)",
    "body": [
      "include \"lib/ai.spark\"",
      "let snippet \"function add(a,b){ return a+b; }\"",
      "ask \"Explain this code in one sentence: {snippet}\" -> answer",
      "print answer"
    ]
  },

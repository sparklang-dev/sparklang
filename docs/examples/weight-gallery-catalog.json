  "role_explainers": {
    "embed": "Token/byte embedding table. Serve looks up rows for prompt bytes, then mean-pools or feeds attn0. Init mixes SPARK_BC bytes into early rows.",
    "lm_head": "Projects the final hidden vector to vocab logits. Primary STEP SGD target (CE on next-byte).",
    "norm": "RMSNorm scale vector (final_norm or per-block). Stabilizes magnitudes before MLP / lm_head.",
    "attn": "Layer attention q/k/v/o (+ attn_norm). Allocated at init; used in serve when present; SGD when train_attn.",
    "mlp": "SwiGLU MLP (up/gate/down + mlp_norm). Layer-0 runs in tiny CPU serve when tensors exist.",
    "other": "Named Spark tensor outside the common embed/attn/mlp/lm_head map \u2014 still F32 stub weights, not HF imports."
  },
  "note": "Gallery lists tiny and large stub configs. Opt-in XL generate prefers 5090; never 6000.",

# Self-host lexer seed (lane A).
# Destination: Spark-hosted lexer run by bootstrap B.
# Today: valid on GAS ./spark --dry-run (no invented lex op).
# Real byte scan: make selfhost-lex && ./selfhost/spark-lex …
#
# Algorithm (to grow into Spark once B can run it):
#   1. Skip ASCII whitespace
#   2. If '#': COMMENT through newline
#   3. If '"': STRING with escapes
#   4. If '-' and next '>': ARROW
#   5. If '|': PIPE
#   6. If digit: NUMBER
#   7. If alpha/_: IDENT; if in keyword set -> KEYWORD
#   8. Else single-byte PUNCT or fail loud
#   9. Emit EOF
#
# GAS pads `let` dumps; Stage 1 golden: fixtures/let_dry.spark.

model code

review path "selfhost/fixtures/mini.spark" -> fixture_review
print fixture_review

review path "selfhost/fixtures/bootstrap_ops.spark" -> bootstrap_review
print bootstrap_review

ask "Self-host lexer seed: C spark-lex is SoT scanner today; grow this .spark on B" -> phase
print phase

ask "Stage 1 B golden: bootstrap_ops.spark lexes tool/with/extract/listen/speak/pipeline" -> stage1_lex
print stage1_lex

